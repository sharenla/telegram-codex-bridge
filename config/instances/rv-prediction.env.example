# Copy to rv-prediction.env and replace only the bot token.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWLIST=123456789,-1001234567890

TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_AUTO=1
TELEGRAM_POLL_TIMEOUT_SECONDS=5
TELEGRAM_TRANSPORT_FAILOVER=1
TELEGRAM_CLASH_PROXY_GROUP=Telegram

# Keep shared tools and Codex configuration aligned with the desktop profile,
# while preserving this instance's own role instructions and generated memories.
CODEX_CONTEXT_SYNC=1
CODEX_CONTEXT_SYNC_AGENTS=0
CODEX_CONTEXT_SYNC_MEMORIES=0
CODEX_MEMORIES_ENABLED=1
DESKTOP_CODEX_HOME=~/.codex
SOURCE_REGISTRY_PATH=
BRIDGE_WORKSPACE_ROOT=/Users/wukong/Documents/Playground/telegram-codex-bridge

CODEX_ACCOUNTS_SOURCE=~/.openclaw/agents/main/agent/auth-profiles.json
CODEX_AUTO_ACCOUNT_FAILOVER=1

CODEX_CWD=/Users/wukong/trading-deribit
CODEX_MODEL=gpt-6-sol
CODEX_EFFORT=high
CODEX_AUTO_ROUTE=off
CODEX_SUMMARY=concise
CODEX_PERSONALITY=friendly

AUTO_COMPACT=0
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX=read-only
# Preserve approval requests for live/API truth access, but handle them inside the bridge.
AUTO_APPROVE=1
